# Make native modules (better-sqlite3) fetch PREBUILT binaries for Electron's ABI
# instead of compiling from source against system Node. This is what lets the project
# install with zero C++ toolchain (no MSVC/ClangCL needed).
#
# IMPORTANT: keep `target` in sync with the "electron" version in package.json.
runtime=electron
target=33.2.1
disturl=https://electronjs.org/headers
build_from_source=false
