{
  "name": "dormy-manager",
  "version": "0.0.1",
  "description": "Offline-first dormitory management desktop app (ElectronJS + React 19 + better-sqlite3)",
  "author": "Wuttichai-SJ",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:auth": "node scripts/auth-smoke.mjs",
    "test:apartments": "node scripts/apartments-smoke.mjs",
    "test:services": "node scripts/services-smoke.mjs",
    "test:utility": "node scripts/utility-smoke.mjs",
    "test:banks": "node scripts/banks-smoke.mjs",
    "test:rooms": "node scripts/rooms-smoke.mjs",
    "test": "npm run test:auth && npm run test:apartments && npm run test:services && npm run test:utility && npm run test:banks && npm run test:rooms && npm run test:tenants && npm run test:contracts && npm run test:bookings",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:tenants": "node scripts/tenants-smoke.mjs",
    "test:contracts": "node scripts/contracts-smoke.mjs",
    "test:bookings": "node scripts/bookings-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.7.0",
    "bcryptjs": "2.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-vite": "2.3.0",
    "vite": "5.4.11",
    "@vitejs/plugin-react": "4.3.4",
    "@electron/rebuild": "3.7.1"
  },
  "engines": {
    "node": ">=20"
  }
}
