{
  "name": "dormy-manager",
  "version": "1.0.4",
  "description": "Offline-first dormitory management desktop app (ElectronJS + React 19 + better-sqlite3)",
  "author": "Wuttichai-SJ",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test:imports": "chcp 65001 >nul && node scripts/imports-smoke.mjs",
    "test:auth": "chcp 65001 >nul && node scripts/auth-smoke.mjs",
    "test:apartments": "chcp 65001 >nul && node scripts/apartments-smoke.mjs",
    "test:services": "chcp 65001 >nul && node scripts/services-smoke.mjs",
    "test:utility": "chcp 65001 >nul && node scripts/utility-smoke.mjs",
    "test:banks": "chcp 65001 >nul && node scripts/banks-smoke.mjs",
    "test:rooms": "chcp 65001 >nul && node scripts/rooms-smoke.mjs",
    "test": "chcp 65001 >nul && npm run test:imports &&npm run test:auth && npm run test:apartments && npm run test:services && npm run test:utility && npm run test:banks && npm run test:rooms && npm run test:tenants && npm run test:contracts && npm run test:bookings && npm run test:backups && npm run test:images && npm run test:meter && npm run test:invoices && npm run test:payments && npm run test:terminations && npm run test:maintenance && npm run test:csv && npm run test:dashboard",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:tenants": "chcp 65001 >nul && node scripts/tenants-smoke.mjs",
    "test:contracts": "chcp 65001 >nul && node scripts/contracts-smoke.mjs",
    "test:bookings": "chcp 65001 >nul && node scripts/bookings-smoke.mjs",
    "test:backups": "chcp 65001 >nul && node scripts/backups-smoke.mjs",
    "test:images": "chcp 65001 >nul && node scripts/images-smoke.mjs",
    "test:meter": "chcp 65001 >nul && node scripts/meter-smoke.mjs",
    "test:invoices": "chcp 65001 >nul && node scripts/invoices-smoke.mjs",
    "test:payments": "chcp 65001 >nul && node scripts/payments-smoke.mjs",
    "test:terminations": "chcp 65001 >nul && node scripts/terminations-smoke.mjs",
    "test:maintenance": "chcp 65001 >nul && node scripts/maintenance-smoke.mjs",
    "test:csv": "chcp 65001 >nul && node scripts/csv-smoke.mjs",
    "test:dashboard": "chcp 65001 >nul && node scripts/dashboard-smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
